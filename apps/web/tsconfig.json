{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"],
  "//": "Tests are typechecked by tsconfig.test.json, not built into dist.",
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
