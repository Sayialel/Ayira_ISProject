{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "CommonJS",
    // "node10" is the explicit name for what used to be "node". Spelling it
    // out means a compiler that drops the old alias still understands this.
    "moduleResolution": "node10",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"],
  "//": "Tests are typechecked by tsconfig.test.json, not compiled into dist.",
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
