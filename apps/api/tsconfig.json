{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"],
  "//": "Tests are typechecked by tsconfig.test.json, not compiled into dist.",
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
