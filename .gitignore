node_modules/
dist/
build/
.env
.env.local
.env.production
*.log
.DS_Store
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/

# Supabase CLI scratch state
supabase/.temp/

# Python virtualenv
apps/ai-engine/.venv/
apps/ai-engine/**/__pycache__/

# KeSCO source PDF — 6.6MB, freely downloadable, fetched by parse_kesco.py
apps/ai-engine/eval/corpus_sources/*.pdf

# Experiment evidence. Run folders are committed deliberately: the workflow
# requires unsuccessful runs to be preserved, and a run is only evidence while
# its log sits beside its metrics. The blanket *.log rule above would drop
# exactly that file, so it is re-included here.
!apps/ai-engine/eval/results/runs/**/run.log
