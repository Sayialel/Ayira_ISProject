node_modules/
dist/
build/
.env
.env.local
.env.production
*.log
.DS_Store
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/

# Supabase CLI scratch state
supabase/.temp/

# Python virtualenv
apps/ai-engine/.venv/
apps/ai-engine/**/__pycache__/

# KeSCO source PDF — 6.6MB, freely downloadable, fetched by parse_kesco.py
apps/ai-engine/eval/corpus_sources/*.pdf

# Experiment evidence. Run folders are committed deliberately: the workflow
# requires unsuccessful runs to be preserved, and a run is only evidence while
# its log sits beside its metrics. The blanket *.log rule above would drop
# exactly that file, so it is re-included here.
!apps/ai-engine/eval/results/runs/**/run.log

# Test runner cache
.pytest_cache/
apps/ai-engine/.pytest_cache/

# Rollback copies of the deployed artefact. Transient local deployment state,
# not evidence: every artefact that backs a reported figure is in its run folder.
apps/ai-engine/artifacts/*.previous

# Raw source snapshots. Immutable but far too large for git; every file is
# recorded in data/manifests/ with its SHA-256, size and retrieval date, so a
# run is reproducible without committing the payload.
data/raw/
data/interim/

# Regenerable pipeline output. The manifests in data/manifests/ are the record
# of what a run produced; the payloads are rebuilt by rerunning the script, and
# committing a partial or inspect-mode output invites reading it as a dataset.
data/processed/*.jsonl
data/synthetic/*.jsonl
