# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# API
API_PORT=3001
AI_ENGINE_URL=http://localhost:8001
# Milliseconds to wait for the AI engine; the first call loads the model.
AI_ENGINE_TIMEOUT_MS=60000
# Shared secret between the gateway and the AI engine; both must match.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_ENGINE_SECRET=generate-a-random-secret
# Origin allowed by CORS. In production set this to your deployed frontend URL.
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# AI Engine
AI_ENGINE_PORT=8001

# Safaricom Daraja (Sandbox)
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret
DARAJA_PASSKEY=your-passkey
DARAJA_SHORTCODE=174379
# Public URL Safaricom posts the payment result to. In development this is
# an ngrok tunnel to localhost:3001, since sandbox cannot reach your machine.
DARAJA_CALLBACK_URL=https://your-public-url/api/escrow/callback
DARAJA_ENV=sandbox

# Africa's Talking (Sandbox)
AT_API_KEY=your-api-key
AT_USERNAME=sandbox

# Firebase Cloud Messaging
FCM_SERVER_KEY=your-server-key

# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:3001

# --- Google OAuth (Supabase external provider) -----------------------------
# Set on the Supabase project, not read by the apps directly. Kept here so the
# provider can be re-enabled without going back to the Google Cloud console.
# Redirect URI to register: https://<project>.supabase.co/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=your-google-client-secret

# --- Supabase Management API ------------------------------------------------
# Only needed to apply migrations and change project settings over HTTPS,
# because the Postgres ports (5432/6543) are firewalled on the dev network.
# Not required to run the application.
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
